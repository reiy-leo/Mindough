// 线上部署配置（API Token 部署）：Web 静态文件放 R2 桶 mindough-web，由 Worker 读出并加 COOP / COEP。
// 原因：Hark 的 token 网关下 wrangler assets 上传会 401 未授权。本地开发仍用 wrangler.jsonc 的 assets。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mindough",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "mindough.rei8t.dev", "custom_domain": true }],
  "r2_buckets": [
    { "binding": "WEB", "bucket_name": "mindough-web" },
    // 用户上传的图片（/api/assets）
    { "binding": "FILES", "bucket_name": "mindough-assets" }
  ],
  // 控制台里配的 GOOGLE_CLIENT_ID 等明文变量，部署时保留
  "keep_vars": true,
  // 云端存储后端：turso（默认，Turso Cloud 东京，凭据是 secret TURSO_DB_URL / TURSO_DB_TOKEN）| d1（下面的 D1 库）。
  // 切换前先跑 `pnpm --filter server storage:copy -- --from turso --to d1` 全量复制并核对，再改这里、重新部署（docs/PLAN.md）。
  "vars": { "STORAGE_BACKEND": "turso" },
  // Cloudflare D1 库 mindough（APAC，Rei 2026-10-17 建）；STORAGE_BACKEND=d1 时同步数据存这里
  "d1_databases": [{ "binding": "DB", "database_name": "mindough", "database_id": "eb0e708a-8764-42fe-a41c-13c9906f16fe" }],
  "observability": { "enabled": true }
}
