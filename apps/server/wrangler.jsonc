// Mindough Worker（本地开发配置；线上用 wrangler.deploy.jsonc）：Google 登录、同步 API、图片、托管 Web 端静态资源。
// 密钥用 `wrangler secret put` 配：GOOGLE_CLIENT_ID、GOOGLE_CLIENT_SECRET、SESSION_SECRET、ALLOWED_EMAILS、TURSO_DB_URL、TURSO_DB_TOKEN；在线找影视另要 TMDB_API_KEY（v3 key 或 v4 读访问令牌，可不配）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mindough",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // app.mindough.rei8t.dev 是网页版 app 和 API；mindough.rei8t.dev 根路径是介绍页，/api、/auth 照常（Rei 2026-10-26，见 src/hosts.ts）
  "routes": [
    { "pattern": "app.mindough.rei8t.dev", "custom_domain": true },
    { "pattern": "mindough.rei8t.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api 与 /auth 先进 Worker，其余直接出静态文件（带 dist/_headers 里的 COOP / COEP）
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  // 用户上传的图片（/api/assets）；本地 wrangler dev 用模拟的 R2
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "mindough-assets" }],
  // 云端存储后端：turso（默认，Turso Cloud 东京，凭据是 secret TURSO_DB_URL / TURSO_DB_TOKEN）| d1（下面的 D1 库）。
  // 切换前先跑 `pnpm --filter server storage:copy -- --from turso --to d1` 全量复制并核对，再改这里、重新部署（docs/PLAN.md）。
  "vars": { "STORAGE_BACKEND": "turso" },
  // Cloudflare D1 库 mindough（APAC，Rei 2026-10-17 建）；STORAGE_BACKEND=d1 时同步数据存这里
  "d1_databases": [{ "binding": "DB", "database_name": "mindough", "database_id": "eb0e708a-8764-42fe-a41c-13c9906f16fe" }],
  // 每天 UTC 19:00（北京 03:00）清理没人用的附件文件（src/purge.ts，Rei 2026-10-25）
  "triggers": { "crons": ["0 19 * * *"] },
  "observability": { "enabled": true }
}
