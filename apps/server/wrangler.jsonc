// Mindough Worker（尚未部署）：Google 登录、/api、托管 Web 端静态资源（apps/client/dist）。
// 密钥用 `wrangler secret put` 配：GOOGLE_CLIENT_ID、GOOGLE_CLIENT_SECRET、SESSION_SECRET、ALLOWED_EMAILS。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mindough",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "mindough.rei8t.dev", "custom_domain": true }],
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api 与 /auth 先进 Worker，其余直接出静态文件（带 dist/_headers 里的 COOP / COEP）
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "observability": { "enabled": true }
}
