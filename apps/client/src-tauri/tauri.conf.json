{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mindough",
  "version": "0.1.0",
  "identifier": "dev.rei8t.mindough",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mindough",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://mindough.rei8t.dev ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "用依赖把任务串起来的任务管理",
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "Resources/zh-Hans.lproj/InfoPlist.strings": "locales/apple/zh-Hans.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "locales/apple/en.lproj/InfoPlist.strings"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "mindough"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "mindough"
          ],
          "host": "auth",
          "appLink": false
        },
        {
          "scheme": [
            "mindough"
          ],
          "host": "task",
          "appLink": false
        },
        {
          "scheme": [
            "mindough"
          ],
          "host": "view",
          "appLink": false
        },
        {
          "scheme": [
            "mindough"
          ],
          "host": "new",
          "appLink": false
        },
        {
          "scheme": [
            "mindough"
          ],
          "host": "checkin",
          "appLink": false
        },
        {
          "scheme": [
            "mindough"
          ],
          "host": "journal",
          "appLink": false
        }
      ]
    }
  }
}
