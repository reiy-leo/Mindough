<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tauri 会把这个文件合进 macOS / iOS 的 Info.plist。显示名的本地化（Rei 2026-10-24：中文「念头团」；2026-10-25 加了西、葡、俄、日、德、法、印尼，这些语言都叫 Mindough）在 locales/apple/*.lproj/InfoPlist.strings。CFBundleLocalizations 要和那些 .lproj 对上，系统才会按这些语言打开 app（WebView 的 navigator.languages 也跟着它）。 -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>zh-Hans</string>
    <string>es</string>
    <string>pt-BR</string>
    <string>ru</string>
    <string>ja</string>
    <string>de</string>
    <string>fr</string>
    <string>id</string>
  </array>
  <key>LSHasLocalizedDisplayName</key>
  <true/>
</dict>
</plist>
