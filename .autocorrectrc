# AutoCorrect（https://github.com/huacnlee/autocorrect）：管中文文档里的中英文空格和标点。
# 只检查 Markdown 文档。代码、i18n 和界面文案不在检查范围，见 .autocorrectignore。
rules:
  # 中文和英文、数字之间加空格
  space-word: 1
  # 中文和标点、括号、反引号之间的空格
  space-punctuation: 1
  space-bracket: 1
  space-backticks: 1
  # 破折号两边加空格：文档里「——」很多，先不管
  space-dash: 0
  # 中文里用全角标点
  fullwidth: 1
  no-space-fullwidth: 1
  # 英文里的全角字母、标点换成半角
  halfwidth-word: 1
  halfwidth-punctuation: 1
  # 拼写检查会改专有名词大小写，容易误伤代码名，先关
  spellcheck: 0
fileTypes:
  "*.md": markdown
# 下面这些原样保留：命中的那一行整行不检查。
# - Rei 的原话引用（引号里的原话不动）
# - 界面上的实际字符串、外部文件的列名、文件名、片名
