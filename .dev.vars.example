# 复制为 apps/server/.dev.vars（不要提交），给 `pnpm --filter server dev`（http://localhost:8787）用。
# Google Cloud Console → OAuth 客户端（Web 应用）→ 已获授权的重定向 URI 加：
#   http://localhost:8787/auth/callback 与 https://mindough.rei8t.dev/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 随机长串，签会话 cookie 用：openssl rand -base64 32
SESSION_SECRET=
# 能登录的 Google 邮箱，逗号分隔；留空 = 谁都不能登录（不是全开放）。登录范围 Rei 还没最终定。
ALLOWED_EMAILS=reiy.leoz@gmail.com
# 允许登录后跳回的其他源（本地 vite 开发）
APP_ORIGINS=http://localhost:1420
# 同步数据库（Turso）。本地开发可以连线上库，也可以 `turso dev` 起本地 libSQL（http://127.0.0.1:8080，token 随便填）
TURSO_DB_URL=
TURSO_DB_TOKEN=
# 在线找影视（可不配；不配时界面显示「TMDB 还没配置」）：themoviedb.org → 设置 → API，v3 API key 或 v4 读访问令牌都行
TMDB_API_KEY=
